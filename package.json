{
  "name": "jpyc-wallet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "compile": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat compile",
    "deploy:sepolia": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/deploy.cts --network sepolia",
    "deploy:amoy": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/deploy.cts --network amoy",
    "deploy:all": "npm run deploy:sepolia && npm run deploy:amoy"
  },
  "dependencies": {
    "@rainbow-me/rainbowkit": "^2.2.4",
    "@tanstack/react-query": "^5.64.1",
